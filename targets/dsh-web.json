{
  "schemaVersion": 1,
  "id": "dsh-web",
  "label": "Generic DSH web profile",
  "profile": {
    "defaultName": "web",
    "rootRelative": ["profiles"],
    "moduleDirectoryRelative": ["profiles", "node_modules"]
  },
  "patch": {
    "relative": ["cordis.patch.yml"],
    "scope": "home",
    "survivesProfileRewrite": true
  },
  "launcher": {
    "command": "dsh --profile <profile>",
    "patchMechanism": "home-level cordis.patch.yml",
    "warning": "The home-level patch is the persistence boundary; a profile-local patch may be regenerated by a launcher."
  },
  "compatibility": {
    "artifacts": [
      {
        "id": "layout",
        "path": ["@deepseek-ai", "dsh-client-ui-layout", "lib", "client.js"],
        "tokens": [
          "data-sidebar-collapsed",
          "_frame",
          "_sidebarCol",
          "_centerCol",
          "_detailsCol",
          "_handle"
        ]
      },
      {
        "id": "conversation",
        "path": ["@deepseek-ai", "dsh-client-ui-conversation", "lib", "client.js"],
        "tokens": [
          "data-conversation-scroll",
          "data-composer-seat",
          "data-composer-card",
          "_scroll"
        ]
      }
    ]
  }
}
